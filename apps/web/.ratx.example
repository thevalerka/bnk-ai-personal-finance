# Copy to .ratx.local (dev) or .ratx.production.local (prod) and fill in.
# Loaded by next.config.ts — a renamed .env.local/.env.production.local,
# kept off the standard dotenv filename on purpose, see
# docs/DECISIONS.md ADR-0010.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8100

# Server Components fetch market data via NEXT_PUBLIC_API_BASE_URL above —
# in production that's the box's own 127.0.0.1 loopback (fast, no public
# round-trip). /profile/* is called directly from the *browser* (event
# tracking, live layout), which can't reach a server's loopback address, so
# it needs the real public API URL. Same value as the one above in local
# dev (both reachable from your own machine); diverges in production —
# see apps/web/.ratx.production.local.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8100
