# Copy to .env and fill in. Each app (apps/api, apps/worker) reads this via
# pydantic-settings; apps/web reads NEXT_PUBLIC_* vars via Next.js directly.

ENV=development

# --- Infra (docker-compose.yml ports) ---
DATABASE_URL=postgresql://amt:amt@localhost:5433/amt
REDIS_URL=redis://localhost:6380/0

# --- AI layer (phase 4) ---
ANTHROPIC_API_KEY=

# --- Market data providers (phase 1) ---
# See docs/PLAN.md section 3.2 for the provider matrix and free-tier limits.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
FRED_API_KEY=
SEC_EDGAR_USER_AGENT=

# --- Web (phase 2+) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
