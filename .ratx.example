# Copy to .ratx and fill in. Each app (apps/api, apps/worker) reads this via
# pydantic-settings (SettingsConfigDict(env_file=".ratx")) — a renamed
# .env, kept off the standard dotenv filename on purpose, see
# docs/DECISIONS.md ADR-0010. apps/web has its own copy: see
# apps/web/.ratx.local (dev) / apps/web/.ratx.production.local (prod),
# loaded by apps/web/next.config.ts.

ENV=development

# --- Infra (docker-compose.yml ports) ---
DATABASE_URL=postgresql://amt:amt@localhost:5433/amt
REDIS_URL=redis://localhost:6380/0

# --- Attention engine (phase 3) ---
# Signs the anonymous profile_id cookie — generate a real random value for
# any real deployment (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`).
# The insecure default in app/config.py is dev-only.
SECRET_KEY=
# The one frontend origin allowed to make credentialed /profile/* requests
# (CORS). Defaults to http://localhost:3000 if unset.
WEB_ORIGIN=

# --- AI layer (phase 4) ---
ANTHROPIC_API_KEY=

# --- Market data providers (phase 1) ---
# See docs/PLAN.md section 3.2 for the provider matrix and free-tier limits.
# Binance and Hyperliquid need no key (public endpoints) and already work.
FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
FRED_API_KEY=

# Not wired to a provider yet — reserved for when Twelve Data/SEC EDGAR land.
TWELVE_DATA_API_KEY=
SEC_EDGAR_USER_AGENT=
